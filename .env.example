# ---------------------------------------------------------------------------
# Axon configuration. Copy to .env and adjust.
# Everything here has a working default except GEMINI_API_KEY.
# ---------------------------------------------------------------------------

# --- Ports & URLs ---
APP_PORT=6002
APP_NAME=Axon

# The public origin, exactly as Caddy serves it - no trailing slash.
# This value signs Twilio webhook verification and builds the webhook and
# invitation URLs shown in the UI, so a mismatch silently breaks both.
#   local:   http://localhost:6002
#   server:  https://axon.8.229.88.229.sslip.io
PUBLIC_URL=http://localhost:6002

# --- Database (docker compose provisions this for you) ---
POSTGRES_USER=axon
POSTGRES_PASSWORD=changeme
POSTGRES_DB=axon
# Only needed when running the server outside Docker:
# DATABASE_URL=postgresql://axon:changeme@localhost:5432/axon

# --- Secrets -----------------------------------------------------------------
# Leave blank and the entrypoint generates ephemeral values on each start.
# Pin both in production: JWT_SECRET keeps sessions alive across restarts, and
# APP_ENCRYPTION_KEY (64 hex chars) keeps stored channel credentials readable.
JWT_SECRET=
APP_ENCRYPTION_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- AI ----------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# Without it the platform runs fine; AI steps use the flow's fallback message
# and AI flow generation is disabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Redis (optional; falls back to in-process caching) ---
ENABLE_REDIS=true
REDIS_URL=redis://redis:6379

# --- Rate limiting ---
THROTTLE_LIMIT=240
THROTTLE_TTL=60

# --- Billing ---
# Temporary paywall until a payment provider is wired up: switching a workspace
# onto any plan above FREE requires this code. Set it to an empty value to block
# self-serve upgrades entirely.
UPGRADE_COUPON=Yash@0110

# --- Misc ---
SIGNUPS_ENABLED=true
SEED_ON_START=true
DEMO_EMAIL=demo@axon.app
DEMO_PASSWORD=demo1234
