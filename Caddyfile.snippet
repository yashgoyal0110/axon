# =============================================================================
# Axon - append this block to your existing Caddyfile.
#
# Caddy terminates public HTTPS and proxies to the Docker container on host
# port 6002. The hostname here MUST match PUBLIC_URL in Axon's .env exactly,
# because that value is what signs Twilio webhooks and builds invite links:
#
#   PUBLIC_URL=https://axon.8.229.88.229.sslip.io
#
# Reload after editing:  caddy reload --config /etc/caddy/Caddyfile
# =============================================================================

https://axon.8.229.88.229.sslip.io {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The SPA is same-origin with its API, so a strict frame policy is safe.
		X-Frame-Options "SAMEORIGIN"
	}

	# Hashed Vite assets are immutable - cache them hard.
	@static path /assets/* /favicon.svg
	header @static Cache-Control "public, max-age=31536000, immutable"

	# index.html must never be cached, or a deploy leaves clients on stale JS.
	@html path / /index.html
	header @html Cache-Control "no-cache, must-revalidate"

	reverse_proxy 127.0.0.1:6002 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port 443

		# Provider webhooks (Meta, Twilio) hold the connection while the flow
		# engine runs an AI turn. 60s sits comfortably above the 20s Gemini
		# timeout and the 15s provider send timeout.
		transport http {
			dial_timeout 10s
			response_header_timeout 60s
		}
	}
}
