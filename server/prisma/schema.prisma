// Axon - multi-tenant WhatsApp AI chatbot platform
// Every business object hangs off an Organization (the tenant boundary).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum PlanStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum Role {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

model Organization {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  billingEmail String?
  plan         Plan       @default(FREE)
  planStatus   PlanStatus @default(TRIALING)
  trialEndsAt  DateTime?
  // Denormalized settings blob: branding, default AI persona, timezone…
  settings     Json       @default("{}")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships   Membership[]
  invitations   Invitation[]
  flows         Flow[]
  channels      Channel[]
  contacts      Contact[]
  conversations Conversation[]
  messages      Message[]
  apiKeys       ApiKey[]
  usage         UsageRecord[]
  dailyStats    DailyStat[]
  auditLogs     AuditLog[]

  @@index([plan])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  avatarUrl     String?
  isSuperAdmin  Boolean   @default(false)
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  createdFlows  Flow[]         @relation("FlowCreatedBy")
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Invitation {
  id         String    @id @default(cuid())
  orgId      String
  email      String
  role       Role      @default(AGENT)
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  prefix     String    @unique
  keyHash    String
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Flows
// ---------------------------------------------------------------------------

enum FlowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Flow {
  id              String     @id @default(cuid())
  orgId           String
  name            String
  description     String?
  status          FlowStatus @default(DRAFT)
  version         Int        @default(1)
  // React Flow graph: { nodes: [], edges: [] }
  graph           Json       @default("{\"nodes\":[],\"edges\":[]}")
  triggerKeywords String[]   @default([])
  aiEnabled       Boolean    @default(true)
  aiPersona       String?
  fallbackMessage String     @default("Sorry, I didn't quite catch that. Could you rephrase?")
  isDefault       Boolean    @default(false)
  publishedAt     DateTime?
  createdById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy     User?          @relation("FlowCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  versions      FlowVersion[]
  channels      Channel[]
  conversations Conversation[]

  @@index([orgId, status])
}

model FlowVersion {
  id        String   @id @default(cuid())
  flowId    String
  version   Int
  graph     Json
  notes     String?
  createdAt DateTime @default(now())

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, version])
}

// ---------------------------------------------------------------------------
// Channels - the WhatsApp connection (or the credential-free sandbox)
// ---------------------------------------------------------------------------

enum ChannelProvider {
  SANDBOX
  META_CLOUD
  TWILIO
}

enum ChannelStatus {
  PENDING
  ACTIVE
  DISABLED
  ERROR
}

model Channel {
  id          String          @id @default(cuid())
  orgId       String
  name        String
  provider    ChannelProvider @default(SANDBOX)
  status      ChannelStatus   @default(PENDING)
  phoneNumber String?
  // AES-256-GCM encrypted provider credentials (never returned raw by the API)
  credentials String?
  // Public webhook identifier - /api/webhooks/:provider/:webhookId
  webhookId   String          @unique
  verifyToken String?
  flowId      String?
  lastErrorAt DateTime?
  lastError   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  flow          Flow?          @relation(fields: [flowId], references: [id], onDelete: SetNull)
  conversations Conversation[]
  messages      Message[]

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Contacts, conversations, messages
// ---------------------------------------------------------------------------

model Contact {
  id         String   @id @default(cuid())
  orgId      String
  waId       String
  name       String?
  attributes Json     @default("{}")
  tags       String[] @default([])
  optedOut   Boolean  @default(false)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([orgId, waId])
  @@index([orgId, lastSeenAt])
}

enum ConversationStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  HANDOFF
}

model Conversation {
  id             String             @id @default(cuid())
  orgId          String
  channelId      String
  contactId      String
  flowId         String?
  status         ConversationStatus @default(ACTIVE)
  currentNodeId  String?
  // Captured answers / computed variables for this session
  variables      Json               @default("{}")
  messageCount   Int                @default(0)
  aiMessageCount Int                @default(0)
  startedAt      DateTime           @default(now())
  lastMessageAt  DateTime           @default(now())
  completedAt    DateTime?

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contact Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  flow    Flow?        @relation(fields: [flowId], references: [id], onDelete: SetNull)

  messages Message[]

  @@index([orgId, status])
  @@index([orgId, lastMessageAt])
  @@index([channelId, contactId, status])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSource {
  FLOW
  AI
  AGENT
  SYSTEM
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id                String           @id @default(cuid())
  orgId             String
  conversationId    String
  channelId         String
  direction         MessageDirection
  source            MessageSource    @default(FLOW)
  body              String
  // Interactive button/list payload rendered by the provider adapter
  payload           Json?
  nodeId            String?
  providerMessageId String?
  status            MessageStatus    @default(QUEUED)
  error             String?
  latencyMs         Int?
  createdAt         DateTime         @default(now())

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([orgId, createdAt])
}

// ---------------------------------------------------------------------------
// Metering, analytics, audit
// ---------------------------------------------------------------------------

model UsageRecord {
  id            String   @id @default(cuid())
  orgId         String
  // Billing period, formatted YYYY-MM
  period        String
  messagesIn    Int      @default(0)
  messagesOut   Int      @default(0)
  aiCalls       Int      @default(0)
  conversations Int      @default(0)
  updatedAt     DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, period])
}

model DailyStat {
  id                     String   @id @default(cuid())
  orgId                  String
  date                   DateTime @db.Date
  messagesIn             Int      @default(0)
  messagesOut            Int      @default(0)
  conversationsStarted   Int      @default(0)
  conversationsCompleted Int      @default(0)
  aiCalls                Int      @default(0)
  avgLatencyMs           Int      @default(0)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, date])
  @@index([orgId, date])
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  actorId   String?
  action    String
  target    String?
  metadata  Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
}

// ---------------------------------------------------------------------------
// Public site traffic
//
// Visits are buffered in memory and flushed in batches, so the write path adds
// no query to a page load. Totals live on a single counter row rather than
// being COUNT(*)'d, which keeps the badge cheap however large PageVisit grows.
// ---------------------------------------------------------------------------

model PageVisit {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  // Salted hash of IP + user agent. Lets us count unique visitors without
  // needing the raw address to be the identifier.
  visitorId String
  ip        String?
  country   String?
  region    String?
  city      String?
  browser   String?
  os        String?
  device    String?
  language  String?
  isBot     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
  @@index([path, createdAt])
  @@index([country])
}

/// One row per distinct visitor. createMany(skipDuplicates) against this table
/// is what yields the new-unique count for a batch in a single query.
model VisitorProfile {
  id        String   @id
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
}

/// Singleton (id = "global"). Incremented once per flush, never per request.
model VisitCounter {
  id             String   @id @default("global")
  totalVisits    Int      @default(0)
  uniqueVisitors Int      @default(0)
  updatedAt      DateTime @updatedAt
}
